rules_version = '2';

// Kalendarz opon: dane czytać i zmieniać mogą tylko zalogowani użytkownicy.
// Konta zakłada właściciel w konsoli Firebase (Authentication → Users),
// a samodzielna rejestracja jest wyłączona (Authentication → Settings → User actions).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
